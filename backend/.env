# =========================

FRONTEND_URL=http://localhost:1573

CORS_ALLOWED_ORIGINS=http://localhost:1573,http://127.0.0.1:1573,https://decency-womb-pulsate.ngrok-free.dev

# =========================
# SMTP
# =========================
# SMTP_USER y SMTP_PASS deben pertenecer a la cuenta
# autorizada para enviar desde notificaciones@revera-legal.com.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP_USER=notificaciones@revera-legal.com
# SMTP_PASS=xxxxxxxx

# SMTP_FROM="REVERA <notificaciones@revera-legal.com>"
# SMTP_REPLY_TO=info@revera-legal.com

# =========================
# DESTINATARIOS INTERNOS
# =========================

